[Unit]
Description=NexusGate Worker
Documentation=man:nexusgate  https://github.com/evjohn-icu/nexusgate
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nexusgate
Group=nexusgate
StateDirectory=nexusgate-worker
RuntimeDirectory=nexusgate-worker
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/nexusgate-worker
Environment=NEXUSGATE_DATA_DIR=/var/lib/nexusgate-worker
Environment=NEXUSGATE_WORKER_TOKEN_FILE=/etc/nexusgate/worker.token
EnvironmentFile=-/etc/nexusgate/worker.env
ExecStart=/usr/local/bin/nexusgate worker run --config /var/lib/nexusgate-worker/worker.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

# This service has no access to the Hub's StateDirectory or SQLite file.
# /srv/nexusgate/media must be the same path exposed to the Hub and is read
# only so a worker cannot modify originals, sidecars, or metadata.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/nexusgate-worker /run/nexusgate-worker
ReadOnlyPaths=/srv/nexusgate/media /etc/nexusgate/tls /etc/nexusgate/worker.token

[Install]
WantedBy=multi-user.target
