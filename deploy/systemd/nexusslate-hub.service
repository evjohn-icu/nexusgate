[Unit]
Description=NexusSlate Hub
Documentation=man:nexusslate  https://github.com/evjohn-icu/nexusslate
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nexusslate
Group=nexusslate
StateDirectory=nexusslate
WorkingDirectory=/var/lib/nexusslate
Environment=NEXUSSLATE_DATA_DIR=/var/lib/nexusslate
Environment=NEXUSSLATE_LISTEN_ADDRESS=127.0.0.1:8787
EnvironmentFile=-/etc/nexusslate/nexusslate.env
ExecStart=/usr/local/bin/nexusslate serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

# The Hub may write only its own state. Media and TLS material are inputs.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/nexusslate
# ReadOnlyPaths must match the directories passed to `nexusslate root add <path>`
# and the TLS certificate location.  Change these when you move your media or
# certificates, or the service will fail to start.
ReadOnlyPaths=/srv/nexusslate/media /etc/nexusslate/tls

[Install]
WantedBy=multi-user.target
