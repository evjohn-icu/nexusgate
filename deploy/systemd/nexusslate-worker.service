[Unit]
Description=NexusSlate Worker
Documentation=man:nexusslate  https://github.com/evjohn-icu/nexusslate
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nexusslate
Group=nexusslate
StateDirectory=nexusslate-worker
RuntimeDirectory=nexusslate-worker
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/nexusslate-worker
Environment=NEXUSSLATE_DATA_DIR=/var/lib/nexusslate-worker
Environment=NEXUSSLATE_WORKER_TOKEN_FILE=/etc/nexusslate/worker.token
EnvironmentFile=-/etc/nexusslate/worker.env
ExecStart=/usr/local/bin/nexusslate worker run --config /var/lib/nexusslate-worker/worker.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

# This service has no access to the Hub's StateDirectory or SQLite file.
# /srv/nexusslate/media must be the same path exposed to the Hub and is read
# only so a worker cannot modify originals, sidecars, or metadata.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/nexusslate-worker /run/nexusslate-worker
ReadOnlyPaths=/srv/nexusslate/media /etc/nexusslate/tls /etc/nexusslate/worker.token

[Install]
WantedBy=multi-user.target
