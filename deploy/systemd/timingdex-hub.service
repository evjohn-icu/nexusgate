[Unit]
Description=Timingdex v0.14 Hub
Documentation=man:timingdex  https://github.com/ev/timingdex
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=timingdex
Group=timingdex
StateDirectory=timingdex
WorkingDirectory=/var/lib/timingdex
Environment=TIMINGDEX_DATA_DIR=/var/lib/timingdex
Environment=TIMINGDEX_LISTEN_ADDRESS=127.0.0.1:8787
EnvironmentFile=-/etc/timingdex/timingdex.env
ExecStart=/usr/local/bin/timingdex serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

# The Hub may write only its own state. Media and TLS material are inputs.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/timingdex
ReadOnlyPaths=/srv/timingdex/media /etc/timingdex/tls

[Install]
WantedBy=multi-user.target
