# ============================================================================
# .dockerignore — files and directories excluded from the Docker build context.
#
# The Dockerfile uses `COPY . .` to bring the repo into the build stage and
# `COPY inference/` in the inference stage. This file keeps the context small
# (faster builds, fewer cache invalidations) by excluding everything the
# compile step does not need, plus the runtime artifacts that must never be
# baked into an image: model weights and virtualenvs are fetched at runtime
# under the digests in inference/models.lock.json, and no image layer ships
# them.
# ============================================================================

# --- Version control (irrelevant inside a build) ---
.git/
.gitattributes
.gitignore

# --- Documentation & specification (not compiled) ---
docs/
skills/
CLAUDE.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
README.md
README_CN.md
SECURITY.md
THIRD-PARTY-LICENSES

# --- Deployment templates (not used at build time) ---
deploy/
docker-compose.yml

# --- CI / GitHub workflows ---
.github/

# --- Shell scripts (not needed at build time) ---
scripts/

# --- Release output and local test fixtures ---
dist/
testdata/
/testdata-local/

# --- Compiled local binaries (built inside the image, never copied in) ---
/nexusgate
/nexusgate-mcp

# --- Python bytecode, caches, virtualenvs and model weights ---
**/__pycache__
**/*.pyc
inference/.venv*
inference/.cache
inference/models

# --- Source archives (accidental by-products, never needed) ---
*.tar.gz
*.tar.xz
*.zip

# --- Config templates & local config (must never be baked in) ---
config.example.json
config.json
.env
.env.*
worker.json

# --- Data directories & credentials ---
.nexusgate*/
admin-token
agent-token
provider-secrets/
store.key

# --- Database files ---
*.db
*.db-wal
*.db-shm

# --- Go test artefacts ---
*.test
coverage.out
*.cover

# --- OS metadata ---
.DS_Store
Thumbs.db
ehthumbs.db

# --- Logs ---
*.log

# --- Docker itself ---
.dockerignore
Dockerfile
